<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.45.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:process id="process_hello-world-inbound-connector" name="Hello World Connector" isExecutable="true">
    <bpmn:serviceTask id="activity_hello-world-connector" name="Hello World!">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="learning::hello-world-outbound-connector" retries="1" />
        <zeebe:ioMapping>
          <zeebe:input source="=event.message" target="message" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0vmlb05</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="event_end">
      <bpmn:incoming>Flow_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="activity_hello-world-connector" targetRef="event_end" />
    <bpmn:startEvent id="event_start" zeebe:modelerTemplate="learning.hello-world-inbound-connector">
      <bpmn:extensionElements>
        <zeebe:properties>
          <zeebe:property name="inbound.type" value="learning::hello-world-inbound-connector" />
          <zeebe:property name="resultVariable" value="event" />
        </zeebe:properties>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_0vmlb05</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_0vmlb05" sourceRef="event_start" targetRef="activity_hello-world-connector" />
  </bpmn:process>
  <bpmn:message id="Message_0bfuteu" name="Message_0bfuteu" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="process_hello-world-inbound-connector">
      <bpmndi:BPMNShape id="activity_hello-world-connector_di" bpmnElement="activity_hello-world-connector">
        <dc:Bounds x="280" y="80" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_1_di" bpmnElement="event_end">
        <dc:Bounds x="462" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_1s7f894_di" bpmnElement="event_start">
        <dc:Bounds x="152" y="102" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_0vmlb05_di" bpmnElement="Flow_0vmlb05">
        <di:waypoint x="188" y="120" />
        <di:waypoint x="280" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
