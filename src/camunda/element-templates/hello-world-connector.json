{
  "$schema": "https://unpkg.com/@camunda/zeebe-element-templates-json-schema/resources/schema.json",
  "id": "learning.hello-world-connector",
  "name": "Hello World Connector",
  "description": "A simple connector that logs a message as INFO.",
  "appliesTo": [
    "bpmn:ServiceTask"
  ],
  "properties": [
    {
      "type": "Hidden",
      "value": "learning::hello-world-connector",
      "binding": {
        "type": "zeebe:taskDefinition",
        "property": "type"
      }
    },
    {
      "type": "Hidden",
      "value": "1",
      "binding": {
        "type": "zeebe:taskDefinition",
        "property": "retries"
      }
    },
    {
      "label": "Message",
      "description": "The message to log.",
      "type": "String",
      "optional": false,
      "binding": {
        "type": "zeebe:input",
        "name": "message"
      },
      "constraints": {
        "notEmpty": true
      }
    }
  ]
}
