<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_1n4r9vb" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.44.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:collaboration id="Collaboration_06qrc6z">
    <bpmn:participant id="Participant_1hg4i35" processRef="process_expenses" />
  </bpmn:collaboration>
  <bpmn:process id="process_expenses" name="Expenses" isExecutable="true">
    <bpmn:extensionElements>
      <zeebe:properties />
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_1yo8bx1">
      <bpmn:lane id="lane_employee" name="Employee">
        <bpmn:flowNodeRef>startEvent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>userTask_submitForm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gateway_approvalNeeded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_1izte9e</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>businessRule_approvalNeeded</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_hr" name="HR">
        <bpmn:flowNodeRef>serviceTask_processExpenses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endEvent_processed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_0bwu2m2" name="Supervisor">
        <bpmn:flowNodeRef>userTask_approval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gateway_approvalDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>endEvent_notApproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>serviceTask_informEmployee</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="startEvent" name="Start">
      <bpmn:outgoing>Flow_15ugdlk</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="userTask_submitForm" name="Submit Form">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form_expenses_input" />
        <zeebe:properties>
          <zeebe:property name="camundaModeler:exampleOutputJson" value="{&#10;  &#34;inputEmployeeId&#34;: &#34;EID-4711&#34;,&#10;  &#34;inputDate&#34;: &#34;2026-04-10&#34;,&#10;  &#34;inputTitle&#34;: &#34;Lorem Ipsum&#34;,&#10;  &#34;inputAmount&#34;: 27.56,&#10;  &#34;inputCurrency&#34;: &#34;EUR&#34;,&#10;  &#34;inputVat&#34;: &#34;DEFAULT_19&#34;,&#10;  &#34;inputDescription&#34;: &#34;Lorem ipsum ..&#34;&#10;}" />
        </zeebe:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_15ugdlk</bpmn:incoming>
      <bpmn:outgoing>Flow_09wzgbz</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gateway_approvalNeeded">
      <bpmn:incoming>Flow_0kpx2pm</bpmn:incoming>
      <bpmn:outgoing>flow_approvalNeeded_yes</bpmn:outgoing>
      <bpmn:outgoing>flow_approvalNeeded_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_1izte9e">
      <bpmn:incoming>flow_approvalDecision_yes</bpmn:incoming>
      <bpmn:incoming>flow_approvalNeeded_no</bpmn:incoming>
      <bpmn:outgoing>Flow_15xrfv1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="businessRule_approvalNeeded" name="Approval Needed?">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="decision_expenses_approvalNeeded" resultVariable="approvalNeeded" />
        <zeebe:properties>
          <zeebe:property name="camundaModeler:exampleOutputJson" value="{&#10;  &#34;approvalNeeded&#34;: true&#10;}" />
        </zeebe:properties>
        <zeebe:ioMapping>
          <zeebe:input source="=inputAmount" target="inputAmount" />
          <zeebe:input source="=inputCurrency" target="inputCurrency" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_09wzgbz</bpmn:incoming>
      <bpmn:outgoing>Flow_0kpx2pm</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:userTask id="userTask_approval" name="Approval">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form_expenses_approval" />
        <zeebe:properties>
          <zeebe:property name="camundaModeler:exampleOutputJson" value="{&#10;  &#34;approvalDecision&#34;: true&#10;}" />
        </zeebe:properties>
        <zeebe:ioMapping>
          <zeebe:output source="=approvalDecision = &#34;true&#34;" target="approvalDecision" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>flow_approvalNeeded_yes</bpmn:incoming>
      <bpmn:outgoing>Flow_1vubf6y</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gateway_approvalDecision">
      <bpmn:incoming>Flow_1vubf6y</bpmn:incoming>
      <bpmn:outgoing>flow_approvalDecision_yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_0lwh7sa</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="endEvent_notApproved" name="Not Approved">
      <bpmn:incoming>Flow_16mkzg2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="serviceTask_processExpenses" name="Process Expenses">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="expenses::process" />
        <zeebe:ioMapping>
          <zeebe:input source="=inputAmount" target="amount" />
          <zeebe:input source="=inputEmployeeId" target="employeeId" />
          <zeebe:input source="=inputCurrency" target="currency" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_15xrfv1</bpmn:incoming>
      <bpmn:outgoing>Flow_0x4z7vy</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="endEvent_processed" name="Processed">
      <bpmn:incoming>Flow_0x4z7vy</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_15ugdlk" sourceRef="startEvent" targetRef="userTask_submitForm" />
    <bpmn:sequenceFlow id="Flow_09wzgbz" sourceRef="userTask_submitForm" targetRef="businessRule_approvalNeeded" />
    <bpmn:sequenceFlow id="Flow_0kpx2pm" sourceRef="businessRule_approvalNeeded" targetRef="gateway_approvalNeeded" />
    <bpmn:sequenceFlow id="flow_approvalNeeded_yes" name="yes" sourceRef="gateway_approvalNeeded" targetRef="userTask_approval">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=approvalNeeded = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_approvalNeeded_no" name="no" sourceRef="gateway_approvalNeeded" targetRef="Gateway_1izte9e">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=approvalNeeded = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_approvalDecision_yes" name="yes" sourceRef="gateway_approvalDecision" targetRef="Gateway_1izte9e">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=approvalDecision = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_15xrfv1" sourceRef="Gateway_1izte9e" targetRef="serviceTask_processExpenses" />
    <bpmn:sequenceFlow id="Flow_1vubf6y" sourceRef="userTask_approval" targetRef="gateway_approvalDecision" />
    <bpmn:sequenceFlow id="Flow_0lwh7sa" name="no" sourceRef="gateway_approvalDecision" targetRef="serviceTask_informEmployee">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=approvalDecision = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_16mkzg2" sourceRef="serviceTask_informEmployee" targetRef="endEvent_notApproved" />
    <bpmn:sequenceFlow id="Flow_0x4z7vy" sourceRef="serviceTask_processExpenses" targetRef="endEvent_processed" />
    <bpmn:sendTask id="serviceTask_informEmployee" name="Inform Employee">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="expenses::informEmployee" />
        <zeebe:ioMapping>
          <zeebe:input source="=inputEmployeeId" target="employeeId" />
          <zeebe:input source="=&#34;NOT_APPROVED&#34;" target="decision" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0lwh7sa</bpmn:incoming>
      <bpmn:outgoing>Flow_16mkzg2</bpmn:outgoing>
    </bpmn:sendTask>
  </bpmn:process>
